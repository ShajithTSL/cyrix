 "html": "<table width= 100%>\n    <tr style = width:30%>\n        <td>\n<img src = \"/files/Cyrix Logo.png\" align=\"left\" width =\"150\"></td>\n{% if doc.company == \"Company Al-Halloul Faniye Medical\"%}\n<td style=text-align:center;font-size:19px;font-weight:bold;width:70%><br>Leave Settlement</td>\n{% else %}\n<td style=text-align:center;font-size:19px;font-weight:bold;width:70%><br>Leave Encashment</td>\n{% endif %}\n        \n    </tr>\n</table>\n<hr>\n<br>\n    <!-- BASIC DETAILS -->\n    <table width=\"100%\" border=\"1\" style=\"border-collapse:collapse; line-height:20px;\">\n        <tr style=\"background:#F3F8FF;\">\n            <td colspan=\"3\" class=\"lbl\"><b>Employee ID</b></td>\n            <td colspan=\"3\" class=\"val\">{{doc.employee}}</td>\n            <td colspan=\"3\" class=\"lbl\"><b>Company</b></td>\n            <td colspan=\"3\" class=\"val\">{{doc.company or '-'}}</td>\n        </tr>\n\n        <tr>\n            <td colspan=\"3\" class=\"lbl\"><b>Employee Name</b></td>\n            <td colspan=\"3\" class=\"val\">{{doc.employee_name}}</td>\n            <td colspan=\"3\" class=\"lbl\"><b>Department</b></td>\n            <td colspan=\"3\" class=\"val\">{{doc.department or '-'}}</td>\n        </tr>\n        {% set designation = frappe.db.get_value(\"Employee\",doc.employee,\"designation\")%}\n        <tr style=\"background:#F3F8FF;\">\n            <td colspan=\"3\" class=\"lbl\"><b>Designation</b></td>\n            <td colspan=\"3\" class=\"val\">{{designation or '-'}}</td>\n            <td colspan=\"3\" class=\"lbl\"><b>Encashment Date</b></td>\n            <td colspan=\"3\" class=\"val\">{{frappe.utils.formatdate(doc.encashment_date)}}</td>\n        </tr>\n    </table>\n    <br>\n    <br>\n    <table width=\"100%\" border=\"1\" style=\"border-collapse:collapse; line-height:20px;\">\n        <tr>\n{% if doc.company == \"TSL COMPANY - KSA\"%}\n<td colspan=\"8\" style=\"background:#0066AD; color:white; text-align:center; font-size:12px; padding:5px;font-weight:bold\">Leave Settlement Details</td>\n{% else %}\n<td colspan=\"8\" style=\"background:#0066AD; color:white; text-align:center; font-size:12px; padding:5px;font-weight:bold\">Leave Encashment Details</td>\n  {% endif %}\n    </tr>\n    </table>\n    <table width=\"100%\" border=\"1\" >\n        <tr style=\"background:#B5D8FB;\">\n            <td colspan=\"3\" style=\"text-align:center; font-weight:bold;\">Description</td>\n            <td colspan=\"1\" style=\"text-align:center; font-weight:bold;\">Details</td>\n        </tr>\n\n        <tr>\n            <td colspan=\"3\" style=\"font-weight:bold;\">Leave Type</td>\n            <td colspan=\"1\" style=\"text-align:center;\">{{doc.leave_type}}</td>\n        </tr>\n\n        <tr>\n            <td colspan=\"3\" style=\"font-weight:bold;\">Leave Balance</td>\n            <td colspan=\"1\" style=\"text-align:center;\">{{\"{:,.2f}\".format(doc.leave_balance)}}</td>\n        </tr>\n\n        <tr>\n            {% if doc.company == \"TSL COMPANY - KSA\"%}\n            <td colspan=\"3\" style=\"font-weight:bold;\">Settlement Days</td>\n            {% else %}\n            <td colspan=\"3\" style=\"font-weight:bold;\">Encashment Days</td>\n            {% endif %}\n            <td colspan=\"1\" style=\"text-align:center;\">{{\"{:,.2f}\".format(doc.encashment_days)}}</td>\n        </tr>\n\n        <tr>\n            {% if doc.company == \"TSL COMPANY - KSA\"%}\n            <td colspan=\"3\" style=\"font-weight:bold;\">Settlement Amount</td>\n            {% else %}\n            <td colspan=\"3\" style=\"font-weight:bold;\">Encashment Amount</td>\n            {% endif %}\n            <td colspan=\"1\" style=\"text-align:center;\">\n                {{\"{:,.2f}\".format(doc.encashment_amount)}} ({{doc.currency}})\n            </td>\n        </tr>\n\n    </table>\n    <br>\n    <br>\n    <br>\n    <br>\n    <br>\n    <br>\n    <br>\n    <br>\n    <br>\n    <br>\n    <br>\n    <br>\n    <br>\n    <br>\n    <br>\n    <br>\n<table  width = 100% style = text-align:center;font-size:12px;font-weight:bold>\n    <tr>\n        <td>Prepared By</td>\n        <td>HR Manager</td>\n        <td>Sr Accountant</td>\n        <td>CEO</td>\n    </tr>\n     <tr>\n        <td></td>\n        <td></td>\n        <td></td>\n        <td></td>\n    </tr>\n   \n    \n</table>\n<br><br>\n<hr>\n        {% set company = frappe.db.get_value(\"Employee\",{\"employee_name\":doc.employee_name},\"company\")%}\n<p style = font-size:11px;>I hereby confirm that I have received the above amount towards my leave encashment dues from  <b>{{company or ''}}</b></p>\n<br><br><br>\n<p style = \"font-weight:bold\">Employee Sign</p>",
