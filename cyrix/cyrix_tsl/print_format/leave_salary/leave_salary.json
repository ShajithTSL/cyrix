 "font_size": 14,
 "html": "<table width= 100%>\n    <tr style = width:30%>\n        <td>\n            <img src = \"/files/Cyrix Logo.png\" align=\"left\" width =\"150\">\n        </td>\n        <td style=text-align:right;font-size:19px;font-weight:bold;width:70%><br>Leave Payment</td>\n    </tr>\n</table>\n\n<table class=\"table table-bordered\" style=\"font-size:10px;width:100%\">\n    <tr>\n        <td style=\"width:25%\"><b>Employee ID</b></td>\n        <td style=\"width:25%\"><b>{{doc.employee}}</b></td>\n          <td>Basic Pay</td>\n        <td style = text-align:right>{{\"{:,.2f}\".format(doc.basic or 0)}}</td>\n        \n    </tr>\n    <tr>\n        <td>Employee Name</td>\n        <td>{{doc.employee_name}}</td>\n        <td style=\"width:25%\">Other Allowance</td>\n        <td style = \"width:25%;text-align:right\">{{\"{:,.2f}\".format(doc.other_allowance or 0)}}</td>\n        \n      \n    </tr>\n    <tr>\n        <td>Designation</td>\n        <td>{{doc.designation or ''}}</td>\n          <td>Food Allowance</td>\n        <td style = text-align:right>{{\"{:,.2f}\".format(doc.food or 0)}}</td>\n       \n    </tr>\n    <tr>\n        <td>Date of Joining</td>\n        <td>{{frappe.utils.formatdate(doc.date_of_joining)}}</td>\n         <td>HRA</td>\n        <td style = \"text-align:right\">{{\"{:,.2f}\".format(doc.hra_salary or 0)}}</td>\n        \n    </tr>\n    <tr>\n        <td>Gross Pay</td>\n        <td style = text-align:right>{{\"{:,.2f}\".format(doc.total_gross_pay or 0)}} </td>\n        <td>Mobile Allowance</td>\n        <td style = \"text-align:right\">{{\"{:,.2f}\".format(doc.mobile_allowance or 0)}}</td>\n       \n    </tr>\n    <tr>\n         <td></td>\n        <!--<td style = \"text-align:right\">{{doc.total_gross_salary or 0}}</td>-->\n       <td></td>\n        <td>Transport Allowance</td>\n        <td style = \"text-align:right\">{{\"{:,.2f}\".format(doc.transport_allowance or 0)}}</td>\n    </tr>\n    <tr>\n        <td colspan = \"6\" style = \"border-color:#0066AD;background-color:#0066AD;text-align:center;color:white;font-weight:bold\">Payroll Details</td>\n    </tr>\n        <tr>\n        <td style=\"width:18.6%;font-size:12px;\">Payroll Start Date</td>\n        <td style=\"width:9%;font-size:12px;\">{{frappe.utils.formatdate(doc.from_date)}}</td>\n        <td style=\"width:18.6%;font-size:12px;\">Earned Basic Pay</td>\n        <td style=\"width:18.6%;font-size:12px;text-align:right\">{{\"{:,.2f}\".format(doc.salary_amount_pay or 0)}}</td>\n        </tr>\n        <tr>\n        <td style=\"width:18.6%;font-size:12px;\">Payroll End Date</td>\n        <td style=\"width:9%;font-size:12px;\">{{frappe.utils.formatdate(doc.to_date)}}</td>\n        <td style=\"width:9%;font-size:12px;\"></td>\n        <td style=\"width:18.6%;font-size:12px;text-align:right\"></td>\n        </tr>\n        <tr>\n        <td style=\"width:18.6%;font-size:12px;\">No.of Days Worked</td>\n        <td style=\"width:9%;font-size:12px;\">{{doc.no_of_days_worked |int or ''}}</td>\n        <td style=\"width:9%;font-size:12px;\"><b>Payroll Total Earned Salary</b></td>\n        {% if doc.company == \"TSL COMPANY - KSA\" %}\n        <td style=\"width:9%;font-size:12px;text-align:right;font-weight:bold\">{{\"{:,.2f}\".format(doc.total_amount or 0)}}</td>\n        {% else %}\n        <td style=\"width:9%;font-size:12px;text-align:right;font-weight:bold\">{{\"{:,.2f}\".format(doc.total_amount|round or 0)}}</td>\n        {% endif %}\n        </tr> \n    <tr>\n        <td colspan = \"6\" style = \"border-color:#0066AD;background-color:#0066AD;text-align:center;color:white;font-weight:bold\">Vacation Settlement</td>\n    </tr>\n    <tr>\n        <td style=\"width:18.6%;font-size:12px;\">Vacation Start Date</td>\n        <td style=\"width:9%;font-size:12px;\">{{frappe.utils.formatdate(doc.leave_start_date)}}</td>\n        \n        {% if doc.deduction_days > 0 %}\n            <td style=\"width:18.6%;font-size:12px;\">Leave Pay Days</td>\n            <td style=\"width:18.6%;font-size:12px;text-align:right\">{{doc.no_of_days | int + doc.special_holidays | int - doc.deduction_days | int}}</td>\n        {% else %}\n            <td style=\"width:18.6%;font-size:12px;\">Leave Balance</td>\n            <td style=\"width:18.6%;font-size:12px;text-align:right\">{{doc.no_of_days}}</td>\n        {% endif%}\n        \n        </tr>\n        <tr>\n        <td style=\"width:18.6%;font-size:12px;\">Vacation End Date</td>\n        <td style=\"width:9%;font-size:12px;\">{{frappe.utils.formatdate(doc.leave_end_date)}}</td>\n        {% if doc.travel_days %}\n        <td style=\"width:9%;font-size:12px;font-weight:bold\">Travel Days</td>\n        <td style=\"width:9%;font-size:12px;text-align:right;font-weight:bold\">{{doc.travel_days}}</td>\n        {% else %}\n        <td style=\"width:9%;font-size:12px;font-weight:bold\">Special Holidays</td>\n        <td style=\"width:9%;font-size:12px;text-align:right;font-weight:bold\">{{doc.special_holidays}}</td>\n        {% endif %}\n        </tr>\n        <tr>\n        <td style=\"width:9%;font-size:12px;\">Leave Encashment</td>\n        \n        <td style=\"width:9%;font-size:12px;\">{{doc.encashment_amount or 0}}</td>\n        <td style=\"width:18.6%;font-size:12px;\">Leave Salary</td>\n        <td style=\"width:18.6%;font-size:12px;text-align:right\">{{\"{:,.2f}\".format(doc.total_salary or 0)}}</td>\n        \n        </tr>\n        <tr>\n        </tr>\n        <!--<tr>-->\n        <!--<td style=\"width:18.6%;font-size:12px;\"></td>-->\n        <!--<td style=\"width:9%;font-size:12px;\"></td>-->\n        <!--<td style=\"width:9%;font-size:12px;font-weight:bold\">Net Payable(Rounded)</td>-->\n        <!--<td style=\"width:18.6%;font-size:12px;text-align:right;font-weight:bold\">{{\"{:,.2f}\".format(doc.total_released_amount|int )}} </td>-->\n        <!--</tr>-->\n         <tr>\n        <td colspan = \"6\" style = \"border-color:#0066AD;background-color:#0066AD;text-align:center;color:white;font-weight:bold\">Other Payments</td>\n    </tr>\n    <tr>\n        <td style=\"width:18.6%;font-size:12px;\">Payment</td>\n        {% if doc.company == \"TSL COMPANY - KSA\" %}\n        <td style=\"width:9%;font-size:12px;text-align:right;\">{{(doc.payment or 0)}}</td>\n        {% else %}\n        <td style=\"width:9%;font-size:12px;text-align:right;\">{{(doc.payment|round  or 0)}}</td>\n        {% endif %}\n        <td style=\"width:18.6%;font-size:12px;\">Payment Reason</td>\n        <td style=\"width:18.6%;font-size:10px;word-wrap: break-word;\">{{doc.payment_reason or \"\"}}</td>\n        </tr>\n        \n        <tr>\n        <td style=\"width:18.6%;font-size:12px;\">Deduction</td>\n        {% if doc.company == \"TSL COMPANY - KSA\" %}\n        <td style=\"width:9%;font-size:12px;text-align:right;\">{{\"{:,.2f}\".format(doc.deduction or 0)}}</td>\n        {% else %}\n        <td style=\"width:9%;font-size:12px;text-align:right;\">{{\"{:,.2f}\".format(doc.deduction|round or 0)}}</td>\n        {% endif %}\n        <td style=\"width:18.6%;font-size:12px;\">Deduction Reason</td>\n        <td style=\"width:18.6%;font-size:10px;\">{{(doc.deduction_reason or \"\")}}</td>\n        </tr>\n     \n        <tr>\n        <td style=\"width:18.6%;font-size:12px;\"></td>\n        <td style=\"width:9%;font-size:12px;\"></td>\n        <td style=\"width:9%;font-size:12px;font-weight:bold\">Net Payable(Rounded)</td>\n        {% if doc.company == \"TSL COMPANY - KSA\" %}\n        <td style=\"width:18.6%;font-size:12px;text-align:right;font-weight:bold\">{{\"{:,.2f}\".format(doc.total_released_amount or 0)}} </td>\n        {% else %}\n        <td style=\"width:18.6%;font-size:12px;text-align:right;font-weight:bold\">{{\"{:,.2f}\".format(doc.total_released_amount|round or 0)}} </td>\n        {% endif %}\n        </tr>\n</table>  \n        {% if doc.company == \"TSL COMPANY - KSA\" %}\n            <p style = font-size:12px;>Amount in Words : <b> {{frappe.utils.money_in_words(doc.total_released_amount or '', doc.currency)}}</b></p>\n        {% else %}\n            <p style = font-size:12px;>Amount in Words : <b> {{frappe.utils.money_in_words(doc.total_released_amount|round or '', doc.currency)}}</b></p>\n        {% endif %}\n<br>\n<table width = 100% style = font-size:12px;>\n    <tr>\n        <td></td>\n        <td style = \"text-align:center\">HR Manager</td>\n        <td style = \"text-align:center\">Finance Manager</td>\n        <td style = \"text-align:center\">CEO</td>\n    </tr>\n    {% if doc.company != \"TSL COMPANY - KSA\"%}\n     <tr>\n        <td></td>\n        <td></td>\n        <td></td>\n        <td></td>\n    </tr>\n    {% else %}\n<br><br><br><br>\n    <tr>\n        <td></td>\n        <td style = \"text-align:center\">Initiated By</td>\n        <td style = \"text-align:center\">Processed By</td>\n        <td style = \"text-align:center\">Approved by</td>\n    </tr>\n    {% endif %}\n   \n    \n</table>\n{% if doc.company != \"TSL COMPANY - KSA\"%}\n<br><br>\n<hr>\n        {% set company = frappe.db.get_value(\"Employee\",{\"employee_name\":doc.employee_name},\"company\")%}\n<p style = font-size:12px;>I hereby confirm having recieved the above amount towards my salary,leave salary and allowances dues from {{company or ''}}</p>\n<br><br>\n<p>Employee Sign</p>\n{% else %}\n{% endif %}",
