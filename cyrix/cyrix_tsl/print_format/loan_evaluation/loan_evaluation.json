 "css": "\n.print-format{\n    /*font-size:20px;*/\n    font-family: 'Calibri';\n    /*margin-top:5px;*/\n    /*margin-left:100px;*/\n    /*margin-right:100px;*/\n    /*margin-bottom:5px;*/\n}    \n\ntable {\n  /*width:80%;*/\n  /*margin-top:0px;*/\n  /*margin-left:25px;*/\n  /*margin-right:25px;*/\n  /*margin-bottom:1px;*/\n}\n\n.column {\n  float: left;\n  width: 50%;\n  padding: 15px;\n}\n\n\n\n",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Loan Request",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div style=\"font-family: Arial, sans-serif; color:#000;\">\n <header id=\"header-html\">\n      </header>\n    <!-- HEADER -->\n    <table width=\"100%\" style=\"border-collapse:collapse; margin-bottom:10px;\">\n        {% set end_date = frappe.utils.get_datetime(doc.end_date) %}\n        <tr>\n            <td width=\"30%\" rowspan=\"2\" style=\"padding:5px;\">\n                    <img width=\"150px\" src=\"/files/Cyrix Logo.png\">\n            </td>\n            <td colspan=\"6\" style=\"text-align:center; font-size:20px; font-weight:bold; color:#0066AD;\">\n                LOAN EVALUATION FORM\n            </td>\n        </tr>\n        <tr>\n            <td colspan=\"6\" style=\"text-align:center; font-size:14px; color:#0066AD; font-weight:bold;\">\n                {{doc.company}}\n            </td>\n        </tr>\n    </table>\n\n    <hr style=\"border:0.3px solid grey;\">\n\n    <!-- BASIC DETAILS -->\n    <table width=\"100%\" border=\"1\" style=\"border-collapse:collapse; line-height:20px;\">\n        <tr style=\"background:#F3F8FF;\">\n            <td colspan=\"3\" class=\"lbl\"><b>Employee ID</b></td>\n            <td colspan=\"3\" class=\"val\">{{doc.employee}}</td>\n             {% set dept = frappe.db.get_value(\"Employee\",{\"name\":doc.employee},'department')%}\n            <td colspan=\"3\" class=\"lbl\"><b>Department</b></td>\n            <td colspan=\"3\" class=\"val\">{{dept or '-'}}</td>\n        </tr>\n\n        <tr>\n            <td colspan=\"3\" class=\"lbl\"><b>Employee Name</b></td>\n            <td colspan=\"3\" class=\"val\">{{doc.employee_name}}</td>\n            <td colspan=\"3\" class=\"lbl\"><b>Date</b></td>\n            <td colspan=\"3\" class=\"val\">{{frappe.utils.formatdate(doc.posting_date)}}</td>\n        </tr>\n\n        <tr style=\"background:#F3F8FF;\">\n             {% set des = frappe.db.get_value(\"Employee\",{\"name\":doc.employee},'designation')%}\n            <td colspan=\"3\" class=\"lbl\"><b>Designation</b></td>\n            <td colspan=\"3\" class=\"val\">{{des or '-'}}</td>\n            {% set doj = frappe.db.get_value(\"Employee\",{\"name\":doc.employee},'date_of_joining')%}\n            <td colspan=\"3\" class=\"lbl\"><b>Date of joining</b></td>\n            <td colspan=\"3\" class=\"val\">{{frappe.utils.formatdate(doj)}}</td>\n        </tr>\n    </table>\n\n    <br>\n\n    <!-- SALARY ADVANCE DETAILS -->\n    <table width=\"100%\" border=\"1\" style=\"border-collapse:collapse; line-height:20px;\">\n        <tr>\n            <td colspan=\"8\" style=\"background:#0066AD; color:white; text-align:center; font-size:14px; padding:5px;\">\n                <b>LOAN REQUEST DETAILS</b>\n            </td>\n        </tr>\n    </table>\n\n    <table width=\"100%\" border=\"1\" style=\"border-collapse:collapse; line-height:20px;\">\n        {% set currency = frappe.db.get_value(\"Company\",doc.company,\"default_currency\") %}\n        <tr style=\"background:#B5D8FB;\">\n            <td colspan=\"3\" style=\"font-size:12px; text-align:center; font-weight:bold;\">Description</td>\n            <td colspan=\"1\" style=\"font-size:12px; text-align:center; font-weight:bold;\">Details</td>\n            <td colspan=\"3\" style=\"font-size:12px; text-align:center; font-weight:bold;\">Description</td>\n            <td colspan=\"1\" style=\"font-size:12px; text-align:center; font-weight:bold;\">Details</td>\n        </tr>\n         <tr >\n             {% set ctc = frappe.db.get_value(\"Employee\",{\"name\":doc.employee},'ctc')%}\n            <td colspan=\"3\" style=\"font-size:12px; font-weight:bold;\">Gross Salary</td>\n            <td colspan=\"1\" style=\"font-size:12px; text-align:center;font-weight:bold;\">{{\"{:,.2f}\".format(ctc)}} ({{currency}})</td>\n            <td colspan=\"3\" style=\"font-size:12px; font-weight:bold;\">Status</td>\n            <td colspan=\"1\" style=\"font-size:12px; text-align:center;\">{{doc.status}}</td>\n            \n        </tr>\n       \n        <tr>\n            <td colspan=\"3\" style=\"font-size:12px; font-weight:bold;\">Loan Amount</td>\n            \n            <td colspan=\"1\" style=\"font-size:12px; text-align:center;\">\n                {{\"{:,.2f}\".format(doc.loan_amount)}} ({{currency}})\n            </td>\n            <td colspan=\"3\" style=\"font-size:12px; font-weight:bold;\">Monthly Repayment Amount</td>\n            <td colspan=\"1\" style=\"font-size:12px; text-align:center;\">{{\"{:,.2f}\".format(doc.repayment_amount)}} ({{currency}})</td>\n        </tr>\n    \n\n        <tr>\n            <td colspan=\"3\" style=\"font-size:12px; font-weight:bold;\">Purpose</td>\n            <td colspan=\"1\" style=\"font-size:12px; text-align:center;\">{{doc.reason or \"\"}}</td>\n             <td colspan=\"3\" style=\"font-size:12px; font-weight:bold;\">Loan Type</td>\n            <td colspan=\"1\" style=\"font-size:12px; text-align:center;\">{{doc.loan_product}}</td>\n        </tr>\n        \n        <tr>\n            <td colspan=\"3\" style=\"font-size:12px; font-weight:bold;\">Repayment Start Date</td>\n            <td colspan=\"1\" style=\"font-size:12px; text-align:center;\">{{frappe.utils.formatdate(doc.repayment_start_date)}}</td>\n            <td colspan=\"3\" style=\"font-size:12px; font-weight:bold;\">Leave Balance Amount</td>\n            <td colspan=\"1\" style=\"font-size:12px; text-align:center;\"> {{\"{:,.2f}\".format(doc.leave_pay)}} ({{currency}})</td>\n        </tr>\n       \n        <tr>\n            \n        </tr>\n        \n    </table>\n{{get_criteria(doc.employee,doc.name)}}\n\n \n\n</div>\n\n<style>\n    .lbl {\n        width:20%; font-size:11px; padding:4px; background:#F8FBFF;\n    }\n    .val {\n        width:30%; font-size:11px; padding:4px;\n    }\n</style>\n<br><br>\n<br><table width = 100%>\n  \n    <tr>\n        <td width=33% colspan=\"6\" style='text-align:center;'> <b>_________________________</b></td>\n        <td width=33% style='text-align:center;' colspan=\"6\"> <b>_________________________ </b></td>\n        <td width=33% style='text-align:center;' colspan=\"6\"> <b>_________________________</b></td>\n        \n    </tr>\n    <tr>\n        <td width=33% colspan=\"6\" style='text-align:center;'> <b>HR Manager</b></td>\n        <td width=33% style='text-align:center;' colspan=\"6\"> <b>Sr. Accountant </b></td>\n        <td width=33% style='text-align:center;' colspan=\"6\"> <b>CEO</b></td>\n        \n    </tr>\n    </table>\n<footer id=\"footer-html\" class=\"footer-html\">\n\n   \n    <p style=\"text-align:center; font-size:11px; color:#444; margin-top:5px;\">\n        This is a system generated document and does not require signature.\n    </p>\n\n</footer>\n",
