 "html": "<meta name=\"pdfkit-orientation\" content=\"landscape\" />\n\n<div><img src = \"/files/Cyrix Logo.png\" align=\"left\" width =\"100\"><h2 style=\"text-transform:uppercase\"><b><center>Salary Summary - {{ frappe.utils.formatdate(doc.start_date, \"MMMM\") }} </center></b></h2></div>\n<h5><center><b>Company :</b> {{doc.company}} - ({{doc.currency}})</center></h5>\n\n\n{% if doc.company == \"Company Al-Halloul Faniye Medical\" %}\n    {% set data_ = salary_register(\n        doc.name,\n        print_context.docstatus\n    ) %}\n    {{data_}}\n{% else %}\n    {% set data_ = salary_register1(\n        doc.name,\n        print_context.docstatus\n    ) %}\n    {{data_}}\n{% endif%}\n\n\n<br><br><br>\n\n<table width=\"100%\" style=\"table-layout:fixed;\">\n    <tr>\n        <td style=\"text-align:center; width:33.33%; padding-top:50px;\">\n            <div style=\"border-bottom:1px solid #000; height:40px;\"></div>\n            HR Manager\n        </td>\n\n        <td style=\"text-align:center; width:33.33%; padding-top:50px;\">\n            <div style=\"border-bottom:1px solid #000; height:40px;\"></div>\n            Sr Accountant\n        </td>\n\n        <td style=\"text-align:center; width:33.33%; padding-top:50px;\">\n            <div style=\"border-bottom:1px solid #000; height:40px;\"></div>\n            CEO\n        </td>\n    </tr>\n</table>",
