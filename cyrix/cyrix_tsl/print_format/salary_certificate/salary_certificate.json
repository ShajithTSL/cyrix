 "html": "<style>\n    \n@import url('https://fonts.googleapis.com/css2?family=Scheherazade+New:wght@400;700&family=Antic&display=swap');\n</style>\n<style>\n\n    body {\n        font-family: Arial, sans-serif;\n        font-size: 12px;\n    }\n\n    .header {\n        text-align: center;\n        margin-bottom: 20px;\n    }\n\n    .title {\n        font-size: 20px;\n        font-weight: bold;\n        text-decoration: underline;\n    }\n\n    .table-main {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 10px;\n    }\n\n    .table-main td {\n        border: 1px solid #000;\n        padding: 8px;\n        vertical-align: middle;\n    }\n\n  \n\n    .value {\n        width: 50%;\n        text-align: center;\n    }\n\n    .arabic {\n        width: 25%;\n        text-align: right;\n        direction: rtl;\n        font-family: 'Scheherazade New' !important;\n    }\n\n    .paragraph {\n        margin-top: 20px;\n        border: 1px solid #000;\n    }\n\n    .paragraph td {\n        padding: 15px;\n        vertical-align: top;\n    }\n\n    .arabic-text {\n        direction: rtl;\n        text-align: right;\n        font-family: 'Scheherazade New' !important;\n        line-height: 1.8;\n    }\n\n    .footer {\n        margin-top: 40px;\n    }\n\n</style>\n{%if doc.company == \"TSL COMPANY - UAE\" and doc.letter_head == 1 %}\n<table width=\"100%\" style=\"border-collapse: collapse; font-famil : 'Antic', sans-serif;\">\n                      <!-- Top row: Left Logo | Quotation | Right Logo -->\n                      <tr>\n                        <td style=\"width: 30%; text-align: left;\">\n                          <img src=\"/files/KSA11.2.jpeg\" alt=\"Left Logo\" style=\"height: 42px;\">\n                        </td>\n                    \n                        <td style=\"width: 40%; text-align: center;\">\n                          <div style=\"font-size: 20px; font-weight: bold;font-family: 'Scheherazade New' !important;\">Salary Certificate <br>\u0634\u0647\u0627\u062f\u0629 \u0631\u0627\u062a\u0628</div>\n                          <div style=\"font-size: 12px; margin-top: 4px;\">\n                          \n                          </div>\n                        </td>\n                    \n                        <td style=\"width: 30%; text-align: right;\">\n                          <img src=\"/files/DUBAI Right1.jpeg\" alt=\"Right Logo\" style=\"height:37px;width:auto;\">\n                        </td>\n                      </tr>\n                    \n                      <!-- Address & Tel row -->\n                      \n                      <tr>\n                        <td style=\"color:#434956; text-align: left; font-size: 12px; padding-top: -1px;font-family: 'Antic', sans-serif;\">\n                          Al Qusais Industrial Area 4,<br>\n                          Damascus Street Warehouse <br>\n                          S03, Dubai.\n                        </td>\n                    \n                        <td></td>\n                    \n                        <td style=\"color:#434956; text-align: right; font-size: 12px; padding-top: -1px;font-family: 'Antic', sans-serif\">\n                          Tel: +971 42870082<br>\n                          Email: info-uae@tsl-me.com<br>\n                          Website: www.tsl-me.com\n                        </td>\n                      </tr>\n                    </table>\n                {% endif %}\n                    {% if doc.company == \"TSL COMPANY - Kuwait\"  and doc.letter_head == 1%}\n                <table width=\"100%\" style=\"border-collapse: collapse; font-family: 'Antic', sans-serif;\">\n                      <!-- Top row: Left Logo | Quotation | Right Logo -->\n                      <tr>\n                        <td style=\"width: 30%; text-align: left;\">\n                          <img src=\"/files/KSA11.2.jpeg\" alt=\"Left Logo\" style=\"height: 50px;\">\n                        </td>\n                                            <td style=\"width: 30%; text-align: center;\">\n                          <div style=\"font-size: 20px; font-weight: bold;font-family: 'Scheherazade New' !important;\"> </div>\n                          <div style=\"font-size: 12px; margin-top: 4px;\">\n                          \n                          </div>\n                        </td>\n                    \n                        \n                        <td style=\"width: 40%; text-align: right;\">\n                          <img src=\"/files/Kuwait1.121.jpeg\" alt=\"Right Logo\" style=\"height:47px;width:auto;\">\n                        </td>\n                      </tr>\n                    \n                      <!-- Address & Tel row -->\n                      \n                      <tr>\n                        <td style=\"color:#434956; text-align: left; font-size: 12px; padding-top: -1px;font-family: 'Antic', sans-serif;\">\n                          Street 24, Bldg 1473-Unit 13,<br>\n                          Al Rai Industrial Area, Block 1 <br>\n                          Kuwait\n                        </td>\n                    \n                        <td></td>\n                    \n                        <td style=\"color:#434956; text-align: right; font-size: 12px; padding-top: -1px;font-family: 'Antic', sans-serif\">\n                          Tel: +965 2474 1313<br>\n                          Email: info@tsl-me.com<br>\n                          Website: www.tsl-me.com\n                        </td>\n                      </tr>\n                    </table>\n                    \n                    {% endif %} {% if doc.letter_head == 0%}<br><br><br><br><br><br><br>{% endif %}\n <div style=\"font-size: 20px; font-weight: bold;font-family: 'Scheherazade New' !important;\"><center>Salary Certificate <br>\u0634\u0647\u0627\u062f\u0629 \u0631\u0627\u062a\u0628</center></div>\n                          <div style=\"font-size: 12px; margin-top: 4px;\">\n                          \n<br>\n\n<table class=\"table-main\">\n    <tr>\n        <td style =\"background-color:#D3D3D3\" class=\"\">Date</td>\n     <td class=\"value\">{{ frappe.utils.formatdate(frappe.utils.today()) }}</td>\n        <td  style =\"background-color:#D3D3D3\"class=\"arabic\">\u0627\u0644\u062a\u0627\u0631\u064a\u062e</td>\n    </tr>\n\n    <tr>\n        <td  style =\"background-color:#D3D3D3\" class=\"\">To</td>\n        <td class=\"value\">{{doc.to}}</td>\n        <td  style =\"background-color:#D3D3D3\" class=\"arabic\">\u0625\u0644\u0649 </td>\n    </tr>\n\n   {% if doc.company == \"TSL COMPANY - UAE\"%}\n    <tr>\n        <td style =\"background-color:#D3D3D3\" class=\"\">Company Name</td>\n        <td class=\"value\">T S L ELECTRONICS SERVICES LLC</td>\n        \n        <td style =\"background-color:#D3D3D3\" class=\"arabic\" >\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629</td>\n    </tr>\n    {% else %}\n   <tr>\n        <td style =\"background-color:#D3D3D3\" class=\"\">Company Name</td>\n        <td class=\"value\">TSL for Precision Equipments and Instruments Trading Co</td>\n        \n        <td style =\"background-color:#D3D3D3\" class=\"arabic\" >\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629</td>\n    </tr>\n    {% endif %}\n   \n    <tr>\n        <td style =\"background-color:#D3D3D3\" class=\"\">Employee Name</td>\n        <td class=\"value\">{{ doc.employee_name }}</td>\n        <td style =\"background-color:#D3D3D3\" class=\"arabic\">\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641</td>\n    </tr>\n\n    <tr>\n        <td style =\"background-color:#D3D3D3\" class=\"\">Nationality</td>\n        <td class=\"value\">{{ doc.nationality }}</td>\n        <td style =\"background-color:#D3D3D3\" class=\"arabic\">\u0627\u0644\u062c\u0646\u0633\u064a\u0629</td>\n    </tr>\n{% if doc.company == \"TSL COMPANY - Kuwait\"%}\n{% if doc.eid__civil_id %}\n    <tr>\n        <td style =\"background-color:#D3D3D3\" class=\"\"> Civil ID</td>\n        <td class=\"value\">{{ doc.eid__civil_id }}</td>\n        <td style =\"background-color:#D3D3D3\" class=\"arabic\">\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u062f\u0646\u064a</td>\n    </tr>\n    {% endif %}\n    {% else %}\n    {% if doc.eid__civil_id %}\n\n     <tr>\n        <td style =\"background-color:#D3D3D3\" class=\"\"> ID Number</td>\n        <td class=\"value\">{{ doc.eid__civil_id }}</td>\n        <td style =\"background-color:#D3D3D3\" class=\"arabic\">  \u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u062f\u0646\u064a</td>\n    </tr>\n     {% endif %}\n    {% endif %}\n     <tr>\n        <td style =\"background-color:#D3D3D3\" class=\"\">Employee No</td>\n        <td class=\"value\">{{ doc.employee }}</td>\n        <td style =\"background-color:#D3D3D3\" class=\"arabic\">   \u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u0638\u0641</td>\n    </tr>\n\n    <tr>\n        <td style =\"background-color:#D3D3D3\" class=\"\">Passport Number</td>\n        <td class=\"value\">{{ doc.passport_number }}</td>\n        <td style =\"background-color:#D3D3D3\" class=\"arabic\">\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0632</td>\n    </tr>\n\n    <tr>\n        <td style =\"background-color:#D3D3D3\" class=\"\">Job Title</td>\n        <td class=\"value\">{{ doc.job_title }}</td>\n        <td style =\"background-color:#D3D3D3\" class=\"arabic\">\u0627\u0644\u0645\u0633\u0645\u0649 \u0627\u0644\u0648\u0638\u064a\u0641\u064a</td>\n    </tr>\n\n    <tr>\n        <td style =\"background-color:#D3D3D3\" class=\"\">Date of Joining</td>\n        <td class=\"value\">{{frappe.utils.formatdate (doc.date_of_joining) }}</td>\n        <td style =\"background-color:#D3D3D3\" class=\"arabic\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0639\u064a\u064a\u0646</td>\n    </tr>\n{% if doc.bank_ac_no %}\n    <tr>\n        <td style =\"background-color:#D3D3D3\" class=\"\">Account No</td>\n        <td class=\"value\">{{ doc.bank_ac_no or \"\" }}</td>\n        <td style =\"background-color:#D3D3D3\" class=\"arabic\">\u0631\u0642\u0645 \u0627\u0644\u062d\u0633\u0627\u0628</td>\n    </tr>\n{% endif%}\n{% if doc.po_box_no %}\n    <tr>\n        <td style =\"background-color:#D3D3D3\" class=\"\">P. O. Box Number</td>\n        <td class=\"value\">{{ doc.po_box_no or \"\" }}</td>\n        <td style =\"background-color:#D3D3D3\" class=\"arabic\">  \u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u0628\u0631\u064a\u062f</td>\n    </tr>\n{% endif%}\n{% if doc.company == \"TSL COMPANY - UAE\"%}\n    <tr>\n        <td style =\"background-color:#D3D3D3\" class=\"\">Total Salary</td>\n     <td class=\"value\">\n    <b>{{ '{:,.2f}'.format(doc.total_salary) }} {{ doc.currency }}</b> /\n    {{ frappe.utils.money_in_words(doc.total_salary, \"AED\")\n        .replace(\"AED\", \"\")\n        .replace(\"only\", \"Emirati Dirhams Only\") }}\n</td>\n        \n        <td style =\"background-color:#D3D3D3\" class=\"arabic\">\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0631\u0627\u062a\u0628</td>\n    </tr>\n{% else %}\n   <tr>\n        <td style =\"background-color:#D3D3D3\" class=\"\">Total Salary</td>\n     <td class=\"value\">\n    <b>{{ '{:,.2f}'.format(doc.total_salary) }} {{ doc.currency }}</b> /\n    {{ frappe.utils.money_in_words(doc.total_salary, \"KWD\")\n     }}\n</td>\n        \n        <td style =\"background-color:#D3D3D3\" class=\"arabic\">\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0631\u0627\u062a\u0628</td>\n    </tr>\n    {% endif %}\n  \n</table>\n\n<style>\n.table-main {\n    width: 100%;\n    table-layout: fixed;\n    border-collapse: collapse;\n    margin-bottom: 20px;\n}\n\n.table-main paragraph td {\n    width: 50%;\n    border: 1px solid #000;\n    padding: 15px;\n    vertical-align: top;\n    height: 180px; /* Fixed height */\n    box-sizing: border-box;\n}\n\n\n</style>\n\n<table class=\"table-main paragraph\">\n    <tr>\n        <td>\n            The above-mentioned employee is still employed with the company up to date. \n            This certificate is issued upon his/her request without any liability on the company. \n            This certificate is valid for three (3) months from the date of issue.\n        </td>\n\n        <td class=\"arabic-text\">\n            \u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0623\u0639\u0644\u0627\u0647 \u0644\u0627 \u064a\u0632\u0627\u0644 \u0639\u0644\u0649 \u0631\u0623\u0633 \u0639\u0645\u0644\u0647 \u062d\u062a\u0649 \u062a\u0627\u0631\u064a\u062e\u0647. \u0648\u0642\u062f \u0623\u064f\u0635\u062f\u0631\u062a \u0647\u0630\u0647 \u0627\u0644\u0634\u0647\u0627\u062f\u0629 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0637\u0644\u0628\u0647 \n            \u062f\u0648\u0646 \u0623\u064a \u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0639\u0644\u0649 \u0627\u0644\u0634\u0631\u0643\u0629. \u0647\u0630\u0647 \u0627\u0644\u0634\u0647\u0627\u062f\u0629 \u0635\u0627\u0644\u062d\u0629 \u0644\u0645\u062f\u0629 \u062b\u0644\u0627\u062b\u0629 (3) \u0623\u0634\u0647\u0631 \u0645\u0646 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0635\u062f\u0627\u0631.\n        </td>\n    </tr>\n</table>\n\n\n\n<div class=\"footer\">\n    {% if doc.company == \"TSL COMPANY - UAE\"%}\n\n    <table style=\"width:100%;\">\n        <tr>\n            <td style=\"text-align:left;\">\n                <b>HR Manager</b><br><br><br><br>\n                ______________________<br>\n              \n            </td>\n\n           \n        </tr>\n    </table>\n    {% else %}\n    <table style=\"width:100%;\">\n        <tr>\n            <td style=\"text-align:left;\">\n                 <b>CEO</b><br><br><br><br>\n                ______________________<br>\n              \n            </td>\n\n           \n        </tr>\n    </table>\n    {% endif %}\n</div>",
