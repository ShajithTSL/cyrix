 "doc_type": "Salary Slip",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "\n<div>\n    <table width = 100% style=\"table-align:center;\">\n        {% set end_date = frappe.utils.get_datetime(doc.end_date) %}\n    <tr>\n        <td width= 30% rowspan = 2 colspan = 3 ><img width = 150px src= \"/files/Cyrix Logo.png\"></td>\n        <td colspan = 6 style=\"text-align:center;font-size:16px;line-height:11px\" ><br><b>SALARY SLIP - {{end_date.strftime(\"%B\")}} {{end_date.strftime(\"%Y\")}}</b></td>\n    </tr>\n    <tr>\n        <td colspan = 6 style=\"text-align:center;font-size:16px;line-height:11px\" ><br><b>{{doc.company}}</b></td>\n    </tr>\n    </table>\n    <hr>\n    {% set mode = frappe.db.get_value(\"Employee\",doc.employee,\"salary_mode\")%}\n    {% set nationality = frappe.db.get_value(\"Employee\",doc.employee,\"nationality\")%}\n    {% set salary_currency = frappe.db.get_value(\"Employee\",doc.employee,\"salary_currency\")%}\n    {% set branch = frappe.db.get_value(\"Employee\",doc.employee,\"branch\")%}\n    \n    <br>\n    <table width = 100% border = 1 style=\"table-align:center;line-height:20px\">\n    <tr>\n        <td colspan = 3 style = 'width:20%;font-size:11px;'><b>Employee ID</b></td>\n        <td colspan = 3 style = 'width:30%;font-size:11px;'>{{doc.employee}}</td>\n        <td colspan = 3 style = 'width:20%;font-size:11px;'><b>Date</b></td>\n        <td colspan = 3 style = 'width:30%;font-size:11px;'>{{frappe.utils.formatdate(doc.posting_date)}}</td>\n    </tr>\n    <tr>\n        <td colspan = 3 style = 'width:20%;font-size:11px;'><b>Employee Name</b></td>\n        <td colspan = 3 style = 'width:30%;font-size:11px;'>{{doc.employee_name}}</td>\n        <td colspan = 3 style = 'width:20%;font-size:11px;'><b>For Period</b></td>\n        <td colspan = 3 style = 'width:30%;font-size:11px;'>{{doc.start_date.strftime('%B')}}</td>\n    </tr>\n    <tr>\n        <td colspan = 3 style = 'width:20%;font-size:11px;'><b>Designation</b></td>\n        <td colspan = 3 style = 'width:30%;font-size:11px;'>{{doc.designation or '-'}}</td>\n        <td colspan = 3 style = 'width:20%;font-size:11px;'><b>Bank Name</b></td>\n        <td colspan = 3 style = 'width:30%;font-size:11px;'>{{doc.bank_name or '-'}}</td>\n    </tr>\n    <tr>\n        <td colspan = 3 style = 'width:20%;font-size:11px;'><b>Department</b></td>\n        <td colspan = 3 style = 'width:30%;font-size:11px;'>{{doc.department or '-'}}</td>\n        <td colspan = 3 style = 'width:20%;font-size:11px;'><b>Payment Mode</b></td>\n        <td colspan = 3 style = 'width:30%;font-size:11px;'>{{mode or '-'}}</td>\n       \n    </tr>\n    <tr>\n        <td colspan = 3 style = 'width:20%;font-size:11px;'><b>Nationality</b></td>\n        <td colspan = 3 style = 'width:30%;font-size:11px;'>{{nationality or '-'}}</td>\n        <td colspan = 3 style = 'width:20%;font-size:11px;'><b>Payment Date</b></td>\n        <td colspan = 3 style = 'width:30%;font-size:11px;'>{{frappe.utils.formatdate(doc.posting_date)}}</td>\n        \n    </tr>\n    <tr>\n        <td colspan = 3 style = 'width:20%;font-size:11px;'><b>Location</b></td>\n        <td colspan = 3 style = 'width:30%;font-size:11px;'>{{branch or '-'}}</td>\n        <td colspan = 3 style = 'width:20%;font-size:11px;'><b>Payment Currency</b></td>\n        <td colspan = 3 style = 'width:30%;font-size:11px;'>{{salary_currency or '-'}}</td>\n    </tr>\n    </table>\n    <!--<br>-->\n    <!--<table width = 99.5% border = 1 style=\"table-align:center;\">-->\n    <!--<tr>-->\n    <!--    <td colspan = 9 style=\"text-align:center;font-size:13px;width:100%;border-right:hidden;border-left:hidden;border-top:hidden\"><b>Attendance Details</b></td>-->\n    <!--</tr>-->\n    <!--<tr>-->\n    <!--    <td colspan = 2 style = 'width:20%;font-size:11px;'><b>Total Working Days</b></td>-->\n    <!--    <td colspan = 1 style = 'width:10%;font-size:11px;text-align:center;'>{{doc.total_working_days  or 0}}</td>-->\n    <!--    <td colspan = 2 style = 'width:20%;font-size:11px;'><b>Total Present Days</b></td>-->\n    <!--    <td colspan = 1 style = 'width:10%;font-size:11px;text-align:center;'>{{doc.payment_days  or 0}}</td>-->\n    <!--    <td colspan = 2 style = 'width:20%;font-size:11px;'><b>Absent Days</b></td>-->\n    <!--    <td colspan = 1 style = 'width:10%;font-size:11px;text-align:center;'>{{doc.absent_days  or 0}}</td>-->\n    <!--</tr>-->\n    <!--</table>-->\n    <br>\n    \n    \n    <table width=100% border = 1 style=\"table-align:center;line-height:20px\">\n    <tr>\n        <td colspan = 8 style=\"background-color:#B5D8FB;text-align:center;font-size:13px;width:100%;\"><b>Salary Details</b></td>\n    </tr>\n    </table>\n    \n\n    \n    {% if doc.deductions %}\n    <table width = 100% border = 1 style=\"table-align:center;line-height:20px\">\n    {% else %}\n    <table width = 100% border = 1 style=\"table-align:center;line-height:20px\">\n    {% endif %}\n    <tr>\n        <td colspan = 3 style = 'width:50%;font-size:11px;text-align:center;color:white;font-weight:bold;background-color:#0066AD'>Earning Details</td>\n        <td colspan = 1 style = 'width:50%;font-size:11px;text-align:center;color:white;font-weight:bold;background-color:#0066AD'>Amount({{doc.currency}})</td>\n    </tr>\n    {% for earn in doc.earnings%}\n    <tr>\n        <td colspan = 3 style = 'width:50%;font-size:11px;'><b>{{earn.salary_component}}</b></td>\n        <td colspan = 1 style = 'width:50%;font-size:11px;text-align:center;'>{{\"{:,.2f}\".format(earn.amount)}}</td>\n    </tr>\n    {% endfor %}\n    <tr>\n        <td colspan = 3 style = 'width:50%;font-size:11px;'><b>Total</b></td>\n        <td colspan = 1 style = 'width:50%;font-size:11px;text-align:center;'><b>{{\"{:,.2f}\".format(doc.gross_pay)}}</b></td>\n    </tr>\n    </table>\n    {% if doc.deductions %}\n    <br>\n    <br>\n    <table width = 100% border = 1 style=\"table-align:center;line-height:20px\">\n    <tr>\n        <td colspan = 3 style = 'width:50%;font-size:11px;text-align:center;color:white;font-weight:bold;background-color:#0066AD'>Deduction Details</td>\n        <td colspan = 1 style = 'width:50%;font-size:11px;text-align:center;color:white;font-weight:bold;background-color:#0066AD'>Amount({{doc.currency}})</td>\n    </tr>\n    {% for ded in doc.deductions%}\n    <tr>\n        <td colspan = 3 style = 'width:50%;font-size:11px;'><b>{{ded.salary_component}}</b></td>\n        <td colspan = 1 style = 'width:50%;font-size:11px;text-align:center;'>{{\"{:,.2f}\".format(ded.amount)}}</td>\n        \n    </tr>\n    {% endfor %}\n    \n    <tr>\n        <td colspan = 3 style = 'width:50%;font-size:11px;'><b>Total</b></td>\n        <td colspan = 1 style = 'width:50%;font-size:11px;text-align:center;'><b>{{\"{:,.2f}\".format(doc.total_deduction)}}</b></td>\n    </tr>\n    </table>\n    {% endif %}\n    \n  \n    <br>\n    <br>\n    {% if doc.loans %}\n    <table width = 100% border = 1 style=\"table-align:center;line-height:20px\">\n        <tr>\n            <td colspan = 9 style = 'background-color:#B5D8FB;width:50%;font-size:13px;text-align:center;'><b>Loan Details</b></td>\n        </tr>\n        <tr>\n            <td colspan = 3 style = 'width:40%;font-size:11px;text-align:center;color:white;font-weight:bold;background-color:#0066AD'>Loan Type</td>\n            <td colspan = 3 style = 'width:30%;font-size:11px;text-align:center;color:white;font-weight:bold;background-color:#0066AD'>Principal Amount</td>\n            <td colspan = 3 style = 'width:30%;font-size:11px;text-align:center;color:white;font-weight:bold;background-color:#0066AD'>Total Payment</td>\n        </tr>\n        {% for loan in doc.loans %}\n        <tr>\n            {% set type = frappe.db.get_value(\"Loan\",loan.loan,'loan_type') %}\n            <td colspan = 3 style = 'width:40%;font-size:11px;text-align:center;'><b>{{type}}</b></td>\n            <td colspan = 3 style = 'width:30%;font-size:11px;text-align:center;'><b>{{\"{:,.2f}\".format(loan.principal_amount)}}</b></td>\n            <td colspan = 3 style = 'width:30%;font-size:11px;text-align:center;'><b>{{\"{:,.2f}\".format(loan.total_payment)}}</b></td>\n        </tr>\n        {% endfor %}\n        {% for loan in doc.loans %}\n        <tr>\n            \n            {% set doc = frappe.get_doc(\"Loan\",loan.loan) %}\n            {% if doc.repayment_schedule %}\n            <td colspan = 9 style = 'width:40%;font-size:11px;text-align:left;'><b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Loan End Date : {{frappe.utils.formatdate(doc.repayment_schedule[-1].payment_date)}}</b></td>\n            {% endif %}\n        </tr>\n        {% endfor %}\n    </table>\n    {% endif %}\n    \n  <br>\n    <br>\n    \n    <table width = 100% style=\"table-align:center;line-height:20px\">\n    <tr>\n        <td colspan = 3 style = 'width:30%;font-size:11px;text-align:center;background-color:#B5D8FB'><b>Net Pay</b></td>\n        <td colspan = 5 style = 'width:70%;font-size:11px;text-align:center;background-color:#B5D8FB'><b>{{\"{:,.2f}\".format(doc.rounded_total)}}{{\"/\"}}{{doc.total_in_words}}</b></td>\n    </tr>\n    \n\n    </table>\n    \n    \n    <br>\n    <br>\n        <table width = 100% border = 1 style=\"table-align:center;line-height:20px\">\n    <tr>\n        <td colspan = 3 style = 'width:20%;font-size:11px;'>\n            <b>Note:</b>\n            <br>\n            <ul>\n                <li>This is a system generated Payslip and doesn't require any Signature</li>\n                <li>For any further clarifications, Please contact HR Department</li>\n            </ul>\n        </td>\n    </tr>\n    \n\n    </table>\n</div>",
