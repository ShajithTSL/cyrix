<td  style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">{{sales_name or \"\"}}</td>-->\n\n\n<!--        </tr>-->\n<!--          <tr>-->\n<!--               {% set cus_vat = frappe.db.get_value(\"Customer\",doc.customer,\"custom_buyer_id\")%}-->\n<!--               {% set cus_vat = frappe.db.get_value(\"Customer\",doc.customer,\"tax_id\")%}-->\n<!--            <th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">Customer's VAT No<br >\u0631\u0642\u0645 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u064a \u0644\u0644\u0639\u0645\u064a\u0644</th>-->\n        \n<!--            <td>{{cus_vat or doc.tax_id or \"\"}}</td>-->\n            \n<!--             <th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">Invoice Date<br>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</th>-->\n        \n<!--            <td>{{doc.get_formatted('posting_date' or \"\")}}</td>-->\n            \n<!--        </tr>-->\n        \n<!--          <tr>-->\n<!--               {% set cus_vat = frappe.db.get_value(\"Customer\",doc.customer,\"custom_buyer_id\")%}-->\n            <!--<th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">Customer's VAT No<br >\u0631\u0642\u0645 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u064a \u0644\u0644\u0639\u0645\u064a\u0644</td>-->\n        \n            <!--<td>{{cus_vat}}</td>-->\n<!--            <td></td>-->\n<!--            <td></td>-->\n            \n<!--             <th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">Supply Date<br>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0648\u0631\u064a\u062f</th>-->\n        \n<!--            <td>{{doc.get_formatted('dos' or \"\")}}</td>-->\n            \n<!--        </tr>-->\n      \n        \n<!--    </table >-->\n    <table style = 'font-size:10px;vertical-align: middle !important;' border = 1 class=\"zebra\" style = \"width:100%\">\n        <tr>\n            <td style=\"width:5%;color:black;text-align:center\"><b>Sr.no</b></td>\n            <td style=\"vertical-align:middle;width:34%;color:black;text-align:center\"><b>Description <br><a style = \"vertical-align:middle;font-size:10px;color:black; font-weight: bold; text-align:right; font-family: 'Tajawal', sans-serif;\"> \u0627\u0644\u0648\u0635\u0641</a></b></td>\n            <td style=\"width:11%;color:black;text-align:left\"><b>Rate <br><a style = \"font-size:10px;color:black; font-weight: bold; text-align:right; font-family: 'Tajawal', sans-serif;\"> \u0633\u0639\u0631 \u0627\u0644\u0648\u062d\u062f\u0629 </a></b></td> \n            <td style=\"width:5.8%;color:black;text-align:left\"><b>Qty <br><a style = \"font-size:10px;color:black; font-weight: bold; text-align:right; font-family: 'Tajawal', sans-serif;\"> \u0627\u0644\u0639\u062f\u062f </a></b></td>\n            \n            {% if doc.additional_discount_percentage > 0 or doc.discount_amount %}\n            <td style=\"width:5.8%;color:black;text-align:left\"><b>Discount<br><a style = \"font-size:10px;color:black; font-weight: bold; text-align:right; font-family: 'Tajawal', sans-serif;\"> \u062e\u0635\u0645 </a></b></td>\n            {% endif %}\n            <td style=\"width:11%;color:black;text-align:left\"><b>Total without Tax <br><a style = \"font-size:10px;color:black; font-weight: bold; text-align:right; font-family: 'Tajawal', sans-serif;\"> \u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0641\u0631\u0639\u064a \u0628\u062f\u0648\u0646 \u0627\u0644\u0636\u0631\u064a\u0628\u0629 </a></b></td>\n            \n            <td style=\"width:9%;color:black;text-align:left\"><b>VAT {{doc.items[0].tax_rate | int}}% <br><a style = \"font-size:10px;color:black; font-weight: bold; text-align:right; font-family: 'Tajawal', sans-serif;\">\u0646\u0633\u0628\u0629 \u0627\u0644\u0636\u0631\u064a\u0628\u0629</a></b></td>\n            <td style=\"width:10%;color:black;text-align:left\"><b>VAT Value <br><a style = \"font-size:10px;color:black; font-weight: bold; text-align:right; font-family: 'Tajawal', sans-serif;\">\u0642\u064a\u0645\u0629 \u0627\u0644\u0636\u0631\u064a\u0628\u0629</a></b></td>\n            <td style=\"width:15%;color:black;text-align:left\"><b>Total Inc.VAT <br><a style = \"font-size:10px;color:black; font-weight: bold; text-align:right; font-family: 'Tajawal', sans-serif;\">\u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0634\u0627\u0645\u0644 \u0636.\u0642.\u0645</a></b></td>\n            \n        </tr>\n        {% for row in doc.items %}\n        <tr  class = \"zebra\">\n            {% set model = frappe.db.get_value(\"Item Model\",row.model,['model']) %}\n            {% set des = frappe.db.get_value(\"Item\",{\"name\":row.item_code},\"description\")%}\n             {% set mfg = frappe.db.get_value(\"Material List\",{\"parent\":row.job_order_data},\"mfg\")%}\n             {% set mfg2 = frappe.db.get_value(\"Item\",{\"name\":row.item_code},\"mfg\")%}\n             \n             <td style=\"text-align:center\">{{loop.index}}</td>\n            <td style=\"text-align:left;font-size:10px;\">\n              <span class=\"inline\">\n                <b>Order No :</b>\n                {{(row.get('job_order_data') or row.get('supply_order_data') or '').split('-')[-1] or row.get(\"order_no\")}}<br>\n                <b>Description :</b> {{ row.get('description', '') }}\n              </span>\n            </td>\n\n            <td style= \"text-align:center\">{{'{:,.2f}'.format((row.rate))}}</td>\n            {% set pm = (row.qty) %}\n            {% set first , second = (\"%.2f\" % pm).split('.') %}\n            <td style= \"text-align:center\">{{pm}}</td>\n            {% if doc.additional_discount_percentage > 0 or doc.discount_amount %}\n            <td style= \"text-align:center\">{{'{:,.2f}'.format((row.distributed_discount_amount or 0))}}</td>\n            {% endif %}\n            \n            <td style= \"text-align:center\">{{'{:,.2f}'.format((row.net_amount))}}</td>\n            <td style= \"text-align:center\">{{row.tax_rate | int or '0'}}%</td>\n            <td style= \"text-align:center\">{{'{:,.2f}'.format((row.tax_amount))}}</td>\n            <td style= \"text-align:center\">{{'{:,.2f}'.format((row.total_amount))}}</td>\n\n\n        </tr>\n        {% endfor %}\n</table>\n\n\n{% set rowspan = 3 %} {# Base rows: Amount, VAT, Grand Total #}\n\n{% if doc.total_advance > 0 %}\n    {% set rowspan = rowspan + 1 %}\n{% endif %}\n{% if doc.discount_amount %}\n    {% set rowspan = rowspan + 2 %} {# Discount + Total After Discount #}\n{% endif %}\n{% if doc.outstanding_amount < 0 or doc.outstanding_amount > 0 %}\n    {% set rowspan = rowspan + 3 %}\n{% endif %}\n\n\n<table style = 'font-size:10px' border =1 style =\"table-layout:fixed;\" width ='100%'>\n   \n    <tr>\n        <th style =\"text-align:left;width:56.2%\"  rowspan = \"{{rowspan}}\" >\n        <img class=\"qr-code\" width = \"125\" height =\"125\" src={{doc.ksa_einv_qr}}>\n        </th>\n\n        <td colspan = \"4\" width = 20% >Amount<br>\u0627\u0627\u0644\u0645\u0628\u0644\u063a <b> ({{doc.currency}})</b></td>\n        <td style= \"text-align:center;\">{{'{:,.2f}'.format ((doc.total - doc.discount_amount or 0))}}</td>\n    </tr>\n    {% if doc.total_advance > 0 %} \n    <tr>\n        <td  style =\"border:1;text-align:center;width:50%\"></td>\n        <td colspan = \"4\"  >Paid Advance <br> \u062f\u0641\u0639\u0629 \u0645\u0642\u062f\u0645\u0629</td>\n        <td style= \"text-align:center;\">{{'{:,.2f}'.format ((doc.total_advance))}}</td>\n    </tr>\n    {% endif %}\n    \n    \n    <tr>\n        <td colspan = \"4\"  >Sales VAT {{doc.items[0].tax_rate | int or '0'}}% <br> \u0627\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0636\u0631\u064a\u0628\u0629%<b> </b></td>\n        <td style= \"text-align:center;\">{{'{:,.2f}'.format((doc.total_taxes_and_charges))}}</td>  \n       \n    </tr>\n    <tr>\n        <td colspan = \"4\"  >Grand Total <br>\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0627\u062c\u0645\u0627\u0644\u064a<b>({{doc.currency}})</b></td>\n        <td style= \"text-align:center;\">{{'{:,.2f}'.format((doc.grand_total))}}</td>  \n       \n    </tr>\n    {% if doc.outstanding_amount < 0 %}\n    <tr>\n         <td colspan = \"4\"  >Paid Amount <br>\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062f\u0641\u0648\u0639<b> ({{doc.currency}})</b></td>\n        <td style= \"text-align:center;\">{{'{:,.2f}'.format((doc.grand_total))}}</td>  \n       \n    </tr>\n    {% endif %}\n    {% if doc.outstanding_amount > 0 %}\n    <tr>\n         <td colspan = \"4\" rowspan = 3 >Total Due <br> \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0633\u062a\u062d\u0642<b> ({{doc.currency}})</b></td>\n        <td style= \"text-align:center;\"  rowspan = 3>{{'{:,.2f}'.format((doc.outstanding_amount))}}</td>  \n       \n    </tr>\n    {% endif %}\n\n</table>\n\n<table  border = 1 style = \"width:100%\" >\n \n    <tr>\n        <td  colspan = 4 style =\"color: black;\"><b><center>Bank Details</center></b><br>\n        </td>\n    </tr>\n    <tr>\n   </tr>\n          <tr style = 'line-height:0.8'>\n            <th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\"> Bank </th>\n          \n             <th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">Alinma Bank  </th>\n\n          \n        </tr>\n    <tr >\n            <th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\"> Beneficiary Name  </th>\n            <td style = \" font-size:12px;color:black; font-weight: bol