 "doctype": "Print Format",
 "font_size": 14,
 "html": "<meta name=\"pdfkit-orientation\" content=\"portrait\" />\n<meta name=\"page-size\" content ='A4'/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Amiri&family=Tajawal&family=Scheherazade&display=swap');\nhr.new1 {\n  border-top: 1px solid black;\n}\n\n</style>\n<header id='header-html'>\n    \n<div class=\"row\">\n<!-- First Table -->\n<div class=\"col-xs-5\" style=\"padding-bottom:7px;\">\n    \n<img src = \"/files/logo.png\" align=\"left\" width =\"160\" height = \"55\" style= \"padding-right:10px;\">\n</div>\n\n<div class=\"col-xs-7\" style=\"padding-top:10px;\">\n{% if doc.is_return %}\n<p style = \" font-size:15px;color:black; font-weight: bold; text-align:right; font-family: 'Tajawal', sans-serif;\"><b>{{ _(\"Credit Note / \u0627\u0634\u0639\u0627\u0631 \u062f\u0627\u0626\u0646\") }}</b></p>\n{% else %}\n<p style = \" font-size:15px;color:black; font-weight: bold; text-align:right; font-family: 'Tajawal', sans-serif;\"><b>{{ _(\"TAX INVOICE / \u0641\u0627\u062a\u0648\u0631\u0629 \u0636\u0631\u064a\u0628\u064a\u0629\") }}</b></p>\n{% endif %}\n<p style = \" font-size:13px;color:black; text-align:right;\">{{doc.name}}</p>\n</div>\n</div>\n\n</header>\n<hr class=\"new1\">\n\n<div class=\"container\">\n<div class=\"row\">\n<!-- First Table -->\n<div class=\"col-xs-6\" style=\"padding: 5px;\">\n    <table style=\"width:100%\">\n           <tr>\n            <th style = \" width:30%;font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal' sans-serif;\">Customer Name / \u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644</th>\n            {% set cus_ar = frappe.db.get_value(\"Customer\",doc.customer,\"zatca_customer_name_in_arabic\")%}\n            <td style = \"  width:30%;font-size:12px;color:black;  text-align:left; font-family: 'Tajawal', sans-serif;\">{{doc.customer}}<br>{{cus_ar}}</td>\n     \n              \n          \n        </tr>\n        \n         <tr>\n            <th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">Address / \u0639\u0646\u0648\u0627\u0646</th>\n             {% set cus_addr = frappe.db.get_value(\"Customer\",doc.customer,\"customer_primary_address\")%}\n             {% set ad1 = frappe.db.get_value(\"Address\",{\"name\":cus_addr},\"address_line1\")%}\n             {% set ad2 = frappe.db.get_value(\"Address\",{\"name\":cus_addr},\"address_line2\")%}\n             {% set city = frappe.db.get_value(\"Address\",{\"name\":cus_addr},\"city\")%}\n             {% set state = frappe.db.get_value(\"Address\",{\"name\":cus_addr},\"state\")%}\n             {% set country = frappe.db.get_value(\"Address\",{\"name\":cus_addr},\"country\")%}\n          <td style = \" font-size:12px;color:black; text-align:left; font-family: 'Tajawal', sans-serif;\">{{doc.address_display}}</td>\n           \n       \n            \n        </tr>\n        \n        \n        {% if doc.plant %}\n        <tr>\n            <th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">Plant / \u0641\u0631\u0639</th>\n            <td style = \" font-size:12px;color:black;  text-align:center; font-family: 'Tajawal', sans-serif;\">{{doc.plant}}</td>\n        </tr>\n        {% endif %}\n        \n          <tr>\n            <th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">Customer PO / \u0631\u0642\u0645 \u0623\u0645\u0631 \u0627\u0644\u062a\u0648\u0631\u064a\u062f</th>\n            <td style = \" font-size:12px;color:black;  text-align:center; font-family: 'Tajawal', sans-serif;\">{{doc.po_no}}</td>\n      \n        </tr>\n        \n        \n      <tr>\n              {% set tax_id1 = frappe.db.get_value(\"Customer\",doc.customer,\"custom_buyer_id\")%}\n            <th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">Customer's CR No<br>\u0631\u0642\u0645 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a \u0644\u0644\u0639\u0645\u064a\u0644</th>\n            <td style = \" font-size:12px;color:black; font-weight: bold; text-align:center; font-family: 'Tajawal', sans-serif;\">{{tax_id1 or \"\"}}</td>\n           \n        </tr>\n        \n         <tr>\n               {% set cus_vat = frappe.db.get_value(\"Customer\",doc.customer,\"custom_buyer_id\")%}\n               {% set cus_vat = frappe.db.get_value(\"Customer\",doc.customer,\"tax_id\")%}\n            <th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">Customer's VAT No<br >\u0631\u0642\u0645 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u064a \u0644\u0644\u0639\u0645\u064a\u0644</th>\n        \n            <td style = \" font-size:12px;color:black; font-weight: bold; text-align:center; font-family: 'Tajawal', sans-serif;\">{{cus_vat or doc.tax_id or \"\"}}</td>\n            \n            \n        </tr>\n        \n        \n        \n        \n        \n    </table>\n </div>  \n  \n    \n<div class=\"col-xs-6\" style=\"padding: 5px;\">\n     <table style=\"width:100%\">\n        <tr>\n            <th style = \" font-size:12px;color:black; font-weight: bold;text-align:left; font-family: 'Tajawal', sans-serif;\">VAT No for CYRIX<br>\u0631\u0642\u0645 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u064a \u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u062d\u0644\u0648\u0644 \u0627\u0644\u0641\u0646\u064a\u0629 \u0627\u0644\u0637\u0628\u064a\u0629</th>            \n            <td>311080423700003</td>\n        </tr>\n        \n        <tr>\n          <th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">Address for CYRIX<br>\n          \u0639\u0646\u0648\u0627\u0646 \u0634\u0631\u0643\u0629 \u0627\u0644\u062d\u0644\u0648\u0644 \u0627\u0644\u0641\u0646\u064a\u0629 \u0627\u0644\u0637\u0628\u064a\u0629\n          </th>\n            <td  style = \" font-size:12px;color:black;  text-align:left; font-family: 'Tajawal', sans-serif;\">{{doc.dispatch_address}}</td>\n            \n        </tr>\n        \n        \n        \n          <tr>\n            \n        <td style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">CR No / \u0631\u0642\u0645 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a</td>                        \n            <td>1010387398</td>\n\n        </tr>\n        \n        \n        <tr>\n            \n             <th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif; \">Sales Person / \u0645\u0646\u062f\u0648\u0628 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a</th>\n        <td  style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">{{doc.sales_person}}</td>\n\n\n        </tr>\n        \n        \n        <tr>\n              \n        <th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">Invoice Date / \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</th>\n        \n            <td>{{doc.get_formatted('posting_date' or \"\")}}</td>\n            \n        </tr>\n        \n        \n          <tr>\n            \n             <th style = \" font-size:12px;color:black; font-weight: bold; text-align:left; font-family: 'Tajawal', sans-serif;\">Supply Date / \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0648\u0631\u064a\u062f</th>\n        \n            <td>{{doc.get_formatted('dos' or \"\")}}</td>\n            \n        </tr>\n        \n        \n        \n    </table>\n    \n </div>\n \n</div>\n</div>\n\n\n\n<!--<table style=\"width:100%\">-->\n    \n   \n<!--        <tr>-->\n<!--            <th style = \" width:30%;font-size:12px;color:black;  text-align:left; font-family: 'Tajawal', sans-serif;\">Customer Name <br>\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644</th>-->\n<!--            {% set cus_ar = frappe.db.get_value(\"Customer\",doc.customer,\"zatca_customer_name_in_arabic\")%}-->\n<!--            <td style = \"  width:30%;font-size:12px;color:black;  text-align:left; font-family: 'Tajawal', sans-serif;\">{{doc.customer}}<br>{{cus_ar}}</td>-->\n     \n<!--              <th style = \" font-size:12px;color:black; font-weight: bold;text-align:left; font-family: 'Tajawal', sans-serif;\">VAT No for TSL<br>\u0631\u0642\u0645 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u064a \u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u062d\u0644\u0648\u0644 \u0627\u0644\u062a\u0642\u0646\u064a\u0629 \u0644\u0644\u0635\u064a\u0627\u0646\u0629</th>-->\n            \n<!--            <td>301189892400003</td>-->\n          \n<!--        </tr>-->\n       \n<!--         <tr>-->\n<!--            <th style = \" font-size:12px;color:black;  text-align:left; font-family: 'Tajawal', sans-serif;\">Address<br>\u0639\u0646\u0648\u0627\u0646</th>-->\n<!--             {% set cus_addr = frappe.db.get_value(\"Customer\",doc.customer,\"customer_primary_address\")%}-->\n<!--             {% set ad1 = frappe.db.get_value(\"Address\",{\"name\":cus_addr},\"address_line1\")%}-->\n<!--             {% set ad2 = frappe.db.get_value(\"Address\",{\"name\":cus_addr},\"address_line2\")%}-->\n<!--             {% set city = frappe.db.get_value(\"Address\",{\"name\":cus_addr},\"city\")%}-->\n<!--             {% set state = frappe.db.get_value(\"Address\",{\"name\":cus_addr},\"state\")%}-->\n<!--             {% set country = frappe.db.get_value(\"Address\",{\"name\":cus_addr},\"country\")%}-->\n<!--          <td style = \" font-size:12px;color:black; text-align:left; font-family: 'Tajawal', sans-serif;\">{{doc.address_display}}</td>-->\n           \n       