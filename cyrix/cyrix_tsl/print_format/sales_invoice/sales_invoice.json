 "css": "\r\n .zebra tr:nth-child(odd) {\r\n            background-color: \t#E0E0E0; /* Applies grey background to even rows */\r\n        }\r\n\r\n.foot{\r\n    text-align:center;\r\n}\r\n/* .invoice-container {*/\r\n/*    display: flex;*/\r\n/*    justify-content: space-between;*/\r\n/*    align-items: flex-start;*/\r\n/*    width: 100%;*/\r\n/*    padding: 15px;*/\r\n  \r\n  /*  border: 1px solid grey; /* Blue border \r\n    border-radius: 5px; /* Rounded corners \r\n\r\n/*}*/\r\n\r\n\r\n\r\n\r\ntd, th {\r\n    padding: 1px; /* Reduce padding */\r\n    margin: 0;\r\n  \r\n}\r\ntr {\r\n    line-height: 1; /* Adjust line height */\r\n}\r\n",
